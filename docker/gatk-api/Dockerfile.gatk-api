# htslib/bcftools/samtools 1.24 built from the upstream tarballs rather than taken from
# Debian: trixie ships 1.21, listed vulnerable to the CRAM-decoder and GZI CVEs fixed
# upstream in 1.21.1. The same version the pharmcat and app images build. See
# docker/common/build-htslib-suite.sh.
FROM python:3.12-slim-trixie AS htslib
COPY docker/common/build-htslib-suite.sh /tmp/
RUN sh /tmp/build-htslib-suite.sh htslib bcftools samtools

# Debian release pinned explicitly, so the base does not float across releases.
FROM python:3.12-slim-trixie

LABEL maintainer="ZaroPGx (wrapper only)"
LABEL description="GATK 4.7.0.0 service for the ZaroPGx pipeline"

# Install system dependencies.
#
# samtools and bcftools produce clinical output here (CRAM/SAM->BAM, its sort and
# index; the BCF->VCF conversion, the liftover's contig rename, every tabix index), so
# they are version-pinned: built at 1.24 in the builder stage above, not taken from
# apt, where the version moves with the Debian release. bedtools is unused.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    wget \
    default-jre \
    unzip \
    bedtools && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# The htslib suite from the builder stage, and the libraries it links at runtime.
COPY --from=htslib /opt/htslib-suite/usr/local/ /usr/local/
RUN apt-get update && apt-get install -y --no-install-recommends \
    zlib1g libbz2-1.0 liblzma5 libcurl4t64 libdeflate0 libncursesw6 \
    && apt-get clean && rm -rf /var/lib/apt/lists/* && ldconfig

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Install GATK
WORKDIR /usr/local
RUN wget -q https://github.com/broadinstitute/gatk/releases/download/4.7.0.0/gatk-4.7.0.0.zip && \
    unzip gatk-4.7.0.0.zip && \
    rm gatk-4.7.0.0.zip && \
    ln -s /usr/local/gatk-4.7.0.0/gatk /usr/local/bin/gatk

WORKDIR /app

# Install Python dependencies with uv into system site-packages
RUN uv pip install --system fastapi uvicorn httpx requests psutil python-multipart

# Create and set proper permissions for data directories
RUN mkdir -p /data/uploads /data/reports /data/results /tmp/gatk_temp && \
    chmod -R 777 /data /tmp/gatk_temp

# Change temporary directory for GATK and set PATH explicitly
ENV TMPDIR=/tmp/gatk_temp
ENV PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"

# Copy the API script and workflow client
COPY docker/gatk-api/gatk_api.py /app/
COPY app/utils/job_client.py /job-client/
# The FASTQ platform detector, shared with the app so the pre-upload plan and
# /align-fastq reach the same verdict about @RG PL:.
COPY app/api/utils/fastq_platform.py /app/

# Expose the API port
EXPOSE 5000

# Run the API
CMD ["python", "gatk_api.py"] 