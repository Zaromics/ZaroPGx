# htslib/bcftools/samtools 1.24 built from the upstream tarballs rather than taken from
# Debian: trixie ships 1.21, listed vulnerable to the CRAM-decoder and GZI CVEs fixed
# upstream in 1.21.1. The same version the pharmcat and app images build. See
# docker/common/build-htslib-suite.sh.
FROM python:3.12-slim-trixie AS htslib
COPY docker/common/build-htslib-suite.sh /tmp/
RUN sh /tmp/build-htslib-suite.sh htslib bcftools

FROM python:3.12-slim-trixie

LABEL description="PyPGx 0.27.0 service for the ZaroPGx pipeline"
LABEL maintainer="ZaroPGx (wrapper only)"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    git \
    curl \
    unzip \
    default-jdk \
    procps \
    gcc \
    g++ \
    libbz2-dev \
    liblzma-dev \
    libcurl4-openssl-dev \
    zlib1g-dev \
    libncurses5-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# bcftools/tabix/bgzip: the wrapper's own calls (PharmCAT's force-called positions, the
# coverage header, contig renames). PyPGx's calling itself uses pysam's bundled copy.
# The htslib suite from the builder stage, and the libraries it links at runtime.
COPY --from=htslib /opt/htslib-suite/usr/local/ /usr/local/
RUN apt-get update && apt-get install -y --no-install-recommends \
    zlib1g libbz2-1.0 liblzma5 libcurl4t64 libdeflate0 libncursesw6 \
    && apt-get clean && rm -rf /var/lib/apt/lists/* && ldconfig

# Set up working directories
RUN mkdir -p /app /data /reference /tmp/pypgx

# Install uv and use it for Python deps
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
# Install PyPGx and dependencies (ensure compatibility with Python 3.12).
# pandas is pinned <3: pypgx 0.26+ breaks on pandas 3.x with
# "ValueError: setting an array element with a sequence" in its string handling,
# which fails every gene in run-ngs-pipeline. 2.2.3 is the version verified against
# this pipeline (2.3.x exists, untested here).
# The scientific stack is pinned too, at what was installed and validated: PyPGx's CNV
# callers are pickled scikit-learn models loaded from the bundle, and fuc/pysam do the
# variant calling, so a floating version changes calls between rebuilds.
RUN uv pip install --system setuptools==80.9.0 "pandas==2.2.3" pypgx==0.27.0 fuc==0.38.0 \
    scikit-learn==1.9.1 numpy==2.5.3 scipy==1.18.1 pysam==0.24.1 \
    autodocsumm psutil fastapi uvicorn httpx python-multipart

# Clone the matching PyPGx bundle repository
# NB: pkg_resources package is slated for removal as early as 2025-11-30. Refrain from using this package or pin to Setuptools<81
RUN cd /root && git clone --branch $(pip show pypgx | grep -oP 'Version: \K.*') --depth 1 https://github.com/sbslee/pypgx-bundle || \
    git clone --branch 0.27.0 --depth 1 https://github.com/sbslee/pypgx-bundle

# Create a simple script to setup environment and run server
WORKDIR /app

# Copy the wrapper script and workflow client
COPY docker/pypgx/pypgx_wrapper.py /app/
COPY docker/pypgx/setup_pypgx.sh /app/
COPY app/utils/job_client.py /job-client/

# Make the setup script executable
RUN chmod +x /app/setup_pypgx.sh

# Expose the port the app runs on
EXPOSE 5000

# Set environment variables
ENV PYTHONPATH=/app
ENV DATA_DIR=/data
ENV TEMP_DIR=/tmp/pypgx
ENV REFERENCE_DIR=/reference
# ENV PYTHONWARNINGS="ignore:invalid escape sequence:SyntaxWarning" # Fixed in PyPGx main

# Health check to ensure the API is responsive
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

# Start the wrapper
CMD ["/app/setup_pypgx.sh"] 