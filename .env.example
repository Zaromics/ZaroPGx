# ZaroPGx example environment configuration
# Copy this file to .env and adjust values as needed
# 
# For different environments, you can also use:
# - .env.local (local development)
# - .env.production (web deployment)
# 
# Run with: docker compose --env-file .env.local up -d

# --- Core application ---
# Leave blank: start-docker generates a per-install value. Do not commit a real secret.
SECRET_KEY=
LOG_LEVEL=DEBUG
ZAROPGX_DEV_MODE=true
# Front-door gate: open (default, no-op) | audit (log would-deny) | password
ZAROPGX_AUTH_MODE=open
# Required only when ZAROPGX_AUTH_MODE=password. Shared install credential —
# anyone who knows it can reach every patient report on this instance.
ZAROPGX_AUTH_PASSWORD=
AUTHOR_NAME=Iliya Yaroshevskiy
SOURCE_URL=https://github.com/Zaromics/ZaroPGx
# Optional: override version shown in reports
ZAROPGX_VERSION=

# --- Container images ---
# Tag of the pre-built images to pull from Docker Hub (zaromicsresearch/zaropgx-*).
# Pin to a release for reproducibility, or set to "latest" to track the newest.
# `docker compose build` overrides these with a local build (fallback).
ZAROPGX_TAG=0.4.0

# --- Security Configuration ---
# JWT token settings (used by main.py authentication)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (application) ---
DB_USER=zaropgx_user
# Leave blank: start-docker generates a per-install value on first init only.
# Never rotate this while zaropgx_pgdata already exists unless you also ALTER ROLE.
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_NAME=zaropgx_db

# --- Internal service URLs ---
NEXTFLOW_RUNNER_URL=http://nextflow:5055
GENOME_DOWNLOADER_API_URL=http://genome-downloader:5050
GATK_API_URL=http://gatk-api:5000
PYPGX_API_URL=http://pypgx:5000
PHARMCAT_API_URL=http://pharmcat:5000
PHARMCAT_JAR_PATH=/pharmcat/pharmcat.jar
FHIR_SERVER_URL=http://fhir-server:8080/fhir
# KROKI_URL is owned by compose.yml (http://kroki:8000 inside the stack).
ZAROHLA_API_URL=http://zarohla:5000

# --- Toggle Services ---
# These should typically be left as true by default.
# Eligible services can be toggled on/off in the UI.
GATK_ENABLED=true
PYPGX_ENABLED=true
OPTITYPE_ENABLED=true
GENOME_DOWNLOADER_ENABLED=true
KROKI_ENABLED=true
HAPI_FHIR_ENABLED=true
# Gates the whole /fhir router (bundle generation, preview, save). Default true.
FHIR_EXPORT_ENABLED=true
# Uploads are deleted when their job ends (completed, failed or cancelled); the
# reports keep the results. true keeps them, e.g. while debugging. Default false.
KEEP_UPLOADS=false

# --- Report artifact toggles ---
# Control inclusion of original PharmCAT outputs alongside app-generated reports.
# Delivered via env_file on the app service (compose no longer hardcodes these).
INCLUDE_PHARMCAT_HTML=true
INCLUDE_PHARMCAT_JSON=true
INCLUDE_PHARMCAT_TSV=true

# --- PDF Generation Configuration ---
# PDF_ENGINE: Choose between 'weasyprint' (default) or 'reportlab'
# - weasyprint: Better HTML/CSS support, modern rendering
# - reportlab: Better text rendering, more reliable for complex layouts
PDF_ENGINE=weasyprint
# PDF_FALLBACK: Enable automatic fallback if primary engine fails (true/false)
PDF_FALLBACK=true
EXECSUM_USE_TSV=true

# --- Optional integrations / tuning ---
# Pinned HAPI FHIR server image tag (bump deliberately; see compose.yml comment)
HAPI_FHIR_TAG=v8.12.0-2
# If set, replaces the version the app reads from the FHIR server. No report or page
# shows HAPI's version at present.
HAPI_FHIR_VERSION=

# PharmCAT configuration
PHARMCAT_VERSION=3.4.0
PHARMCAT_LOG_LEVEL=DEBUG
# Assume-reference flags. PharmCAT documents both as DANGEROUS. They reach PharmCAT
# for VCF/BCF uploads only: aligned reads and gVCFs are genotyped at every PharmCAT
# position, and there the flags could only turn "not covered" into "reference".
PHARMCAT_UNSPECIFIED_TO_REF=false
PHARMCAT_ABSENT_TO_REF=false

# PyPGx configuration
PYPGX_PHARMCAT_PREFERENCE=pharmcat
PYPGX_MEMORY_LIMIT=12G
PYPGX_MAX_PARALLEL_GENES=8
PYPGX_BATCH_SIZE=4

# Outside-calls / report merge override (empty = default behaviour)
OUTSIDECALLSOVERRIDE=

# Memory and logging hints for services (interpolated into compose when set)
JAVA_OPTS=-Xmx4g
MAX_MEMORY=20g
DOWNLOAD_ON_STARTUP=true

# The CRAM reference cache the genome downloader builds after the genomes: 3.2 GB
# downloaded, 5.3 GB kept under reference/ref_cache. false skips it: CRAMs then decode
# only if they were written against UCSC hg38, and Run Demo (a CRAM) answers 503.
# Default true.
#REF_CACHE_ENABLED=true

# --- File Paths ---
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports

# --- Docker Compose Overrides ---
# Requires Docker Compose >= 2.24 (env_file path/required form on the app service).
# Host address and port for the app. 127.0.0.1:8765 serves this machine only.
# 0.0.0.0:8765 (or a bare 8765) listens on every interface: use it to run the app on
# one machine and open it from others on your network. With ZAROPGX_AUTH_MODE=open,
# anyone who can reach the port gets in without a password. Beyond your network, put
# it behind a TLS reverse proxy (docs: Running a server).
BIND_ADDRESS=127.0.0.1:8765

# Host interface for the INTERNAL services (postgres, pharmcat, gatk-api, pypgx, zarohla,
# genome-downloader, fhir-server, kroki, docs). These speak to each other over the compose
# network and none of them authenticate, so they are bound to loopback only. The mapping
# still exists, so `curl localhost:5001/health` from the Docker host works exactly as before.
#
# Change this only if you genuinely need another machine to reach them directly, and
# understand that it exposes unauthenticated services plus a database whose password may be
# whatever the template shipped. Prefer an SSH tunnel: ssh -L 5444:127.0.0.1:5444 <host>
INTERNAL_BIND_ADDRESS=127.0.0.1

# Network subnet configuration:
# - Local development: NETWORK_SUBNET=172.20.0.0/16
# - Production/web: NETWORK_SUBNET=172.28.0.0/16
NETWORK_SUBNET=172.20.0.0/16

# Header inspection caps
MAX_HEADER_READ_BYTES=1000000000
MAX_HEADER_PARSE_TIMEOUT_SEC=300

# How long the app polls a submitted Nextflow job before giving up and marking it FAILED.
# A backstop against a wedged run, not a service-level objective: a WGS FASTQ run can
# legitimately take most of a day, so keep this generous. Default 86400 (24 hours).
NEXTFLOW_MAX_WAIT_SECONDS=86400

# The largest FASTQ aligned, both mates together, in bytes. Default 20 GiB. The app
# and gatk-api both read it. Aligning needs about 9 times the FASTQ's size in free
# disk (gatk-api checks before it starts) and hours for a whole genome.
#FASTQ_MAX_UPLOAD_BYTES=21474836480

# Where zarohla writes the BAM->FASTQ conversion for OptiType. This is the
# largest and shortest-lived write in the stack: a whole WGS alignment becomes
# tens of GB of FASTQ that OptiType reads once and discards. Point it at a disk
# with room if ./data is on a small one. Unset, it defaults to ./data/temp.
#ZAROPGX_SCRATCH=/mnt/big-disk/zaropgx-scratch

# Threads samtools uses as zarohla extracts an alignment's HLA reads and converts them
# for OptiType. A genome with tens of millions of unplaced reads spends most of its HLA
# time there. Default 4.
#ZAROHLA_SAMTOOLS_THREADS=4

# Host directory holding the PyPGx-compliant GRCh38 FASTA and its bwa index
# (built by scripts/build-align-index.sh). ~9 GB; kept off the image on purpose.
#ZAROPGX_ALIGN_REFERENCE=/mnt/big-disk/zaropgx-reference
