# ZaroPGx Local Development Environment Configuration
# For local development and LAN access

# --- Core application ---
# Leave blank: start-docker generates a per-install value. Do not commit a real secret.
SECRET_KEY=
LOG_LEVEL=DEBUG
ZAROPGX_DEV_MODE=true
ZAROPGX_AUTH_MODE=open
ZAROPGX_AUTH_PASSWORD=
AUTHOR_NAME=Iliya_Yaroshevskiy
SOURCE_URL=https://github.com/Zaromics/ZaroPGx
# Image tag for zaromicsresearch/zaropgx-* (compose default is used if blank)
ZAROPGX_TAG=0.2.8

# --- Security Configuration ---
# JWT token settings (used by main.py authentication)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (application) ---
DB_USER=zaropgx_user
# Leave blank: start-docker generates a per-install value on first init only.
# Never rotate this while zaropgx_pgdata already exists unless you also ALTER ROLE.
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_NAME=zaropgx_db

# --- Internal service URLs ---
NEXTFLOW_RUNNER_URL=http://nextflow:5055
GENOME_DOWNLOADER_API_URL=http://genome-downloader:5050
GATK_API_URL=http://gatk-api:5000
PYPGX_API_URL=http://pypgx:5000
PHARMCAT_API_URL=http://pharmcat:5000
PHARMCAT_JAR_PATH=/pharmcat/pharmcat.jar
FHIR_SERVER_URL=http://fhir-server:8080/fhir
# KROKI_URL is owned by compose (http://kroki:8000). Do not set it here.
ZAROHLA_API_URL=http://zarohla:5000

# --- Toggle Services ---
# These should typically be left as true by default.
# Eligible services can be toggled on/off in the UI.
GATK_ENABLED=true
PYPGX_ENABLED=true
OPTITYPE_ENABLED=true
GENOME_DOWNLOADER_ENABLED=true
KROKI_ENABLED=true
HAPI_FHIR_ENABLED=true

# --- Report artifact toggles ---
# JSON/TSV default true: compose no longer hardcodes these; .env is authoritative.
INCLUDE_PHARMCAT_HTML=true
INCLUDE_PHARMCAT_JSON=true
INCLUDE_PHARMCAT_TSV=true

# --- PDF Generation Configuration ---
# PDF_ENGINE: Choose between 'weasyprint' (default) or 'reportlab'
# - weasyprint: Better HTML/CSS support, modern rendering
# - reportlab: Better text rendering, more reliable for complex layouts
PDF_ENGINE=weasyprint
# PDF_FALLBACK: Enable automatic fallback if primary engine fails (true/false)
PDF_FALLBACK=true
EXECSUM_USE_TSV=true

# --- Optional integrations / tuning ---
HAPI_FHIR_TAG=v8.10.0-2
HAPI_FHIR_VERSION=

# PharmCAT configuration
PHARMCAT_VERSION=3.4.0
PHARMCAT_LOG_LEVEL=DEBUG

# PyPGx configuration
PYPGX_PHARMCAT_PREFERENCE=pharmcat
PYPGX_MEMORY_LIMIT=7G
PYPGX_MAX_PARALLEL_GENES=8
PYPGX_BATCH_SIZE=4

# Outside-calls / report merge override (empty = default behaviour)
OUTSIDECALLSOVERRIDE=

# File paths
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports

# Memory and logging hints for services
JAVA_OPTS=-Xmx4g
MAX_MEMORY=20g
DOWNLOAD_ON_STARTUP=true

# Header inspection caps
MAX_HEADER_READ_BYTES=1000000000
MAX_HEADER_PARSE_TIMEOUT_SEC=300

# --- Docker Compose Overrides ---
# Local: Bind to localhost only for development
BIND_ADDRESS=8765

# Host interface for the INTERNAL services (postgres, pharmcat, gatk-api, pypgx, zarohla,
# genome-downloader, fhir-server, kroki, docs). These speak to each other over the compose
# network and none of them authenticate, so they are bound to loopback only. The mapping
# still exists, so `curl localhost:5001/health` from the Docker host works exactly as before.
#
# Change this only if you genuinely need another machine to reach them directly, and
# understand that it exposes unauthenticated services plus a database whose password may be
# whatever the template shipped. Prefer an SSH tunnel: ssh -L 5444:127.0.0.1:5444 <host>
INTERNAL_BIND_ADDRESS=127.0.0.1
# Local: Use local development subnet
NETWORK_SUBNET=172.20.0.0/16
