// docker/nextflow/runner.py runs `-profile standard`. Every process here runs in this
// container and calls a service over HTTP, so there is no docker or conda profile:
// with no Docker socket mounted, a docker profile could not start a container anyway.
profiles {
  standard {
    process.executor = 'local'
  }
}

params {
  skip_hla = false
  reference = 'hg38'
  outdir = 'data/reports'
}

process {
  // Exit 65 is a service refusing the input with a 4xx (main.nf header): a retry
  // would be refused again, after re-sending the whole input.
  errorStrategy = { task.exitStatus == 65 ? 'terminate' : 'retry' }
  maxRetries = 1

  // No cpus or memory per process. Each process runs curl against a service, and the
  // service's own container limits (compose.yml) bound the real work. The local executor
  // refuses outright a task that asks for more than the host has: the HLA step's old
  // `memory = '30 GB'` failed every alignment job on a host with less than 30 GB, and
  // `cpus = 4` every job on a 2-CPU host.
}

workDir = 'data/nextflow/work'

// runner.py points these at the job's own directory (-with-trace, -with-timeline,
// -with-report); the fields list below still applies to its trace.txt.
trace {
    enabled = true
    file = 'data/nextflow/trace.txt'
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,tag,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled = true
    file = 'data/nextflow/timeline.html'
}

report {
    enabled = true
    file = 'data/nextflow/report.html'
}



